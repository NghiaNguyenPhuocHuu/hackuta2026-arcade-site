# Copy to .env.local for local development (.env.local is git-ignored).
# This project uses ONE Convex deployment exclusively: brazen-peccary-506 (sandbox).

# === Frontend (VITE_* is public; baked into the browser bundle) ===
VITE_CONVEX_URL=https://brazen-peccary-506.convex.cloud
VITE_CONVEX_SITE_URL=https://brazen-peccary-506.convex.site

# Where "Back to profile" and the signed-out screen send hackers (the participant dashboard).
# VITE_PROFILE_URL=
# VITE_LANDING_URL=https://hackuta.com

# "live" reads the arcade from Convex (sign-in from profile, real points, Olympus 21 PvP).
# Needs the arcade backend pushed to the deployment; until then leave it unset (mock data).
# ?preview=… in the URL always uses the mock.
# VITE_ARCADE_BACKEND=live

# === Local / CLI only (tells `npx convex ...` which deployment to target) ===
CONVEX_DEPLOYMENT=dev:brazen-peccary-506

# === Convex server env vars ===
# Set with `npx convex env set NAME value` from build/peccary. Never as VITE_*, never committed.
