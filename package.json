{
  "name": "hackuta2026-arcade-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "backend:assemble": "node scripts/assemble-backend.mjs",
    "backend:test": "node scripts/test-backend.mjs",
    "backend:check": "node scripts/check-no-function-loss.mjs",
    "convex:guard": "node scripts/guard-convex-target.mjs",
    "convex:push": "node -e \"console.error('Refusing: this repo has no full backend, so pushing from here would delete every function on peccary. Assemble with npm run backend:assemble and push from build/peccary (see backend/README.md).');process.exit(1)\""
  },
  "dependencies": {
    "convex": "^1.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  }
}
